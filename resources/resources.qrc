        <file alias="grid.svg">icons/svg/grid.svg</file>
        <file alias="settings.svg">icons/svg/settings.svg</file>
        <file alias="backup.svg">icons/svg/backup.svg</file>
        <file alias="help.svg">icons/svg/help.svg</file>
        <file alias="search.svg">icons/svg/search.svg</file>
        <file alias="download.svg">icons/svg/download.svg</file>
        <file alias="trash.svg">icons/svg/trash.svg</file>
        <file alias="users.svg">icons/svg/users.svg</file>
        <file alias="image.svg">icons/svg/image.svg</file>
        <file alias="send.svg">icons/svg/send.svg</file>
        <file alias="close.svg">icons/svg/close.svg</file>
        <file alias="hash.svg">icons/svg/hash.svg</file>
        <file alias="server.svg">icons/svg/server.svg</file>
