ARG BASE=debian:12-slim
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
# Deliberately no Qt runtime/dev packages here: AppImage must supply its Qt;
# the deb must obtain its own runtime through declared apt dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates python3 openssl xvfb xdotool x11-utils fonts-dejavu-core \
    libgl1 libegl1 libopengl0 libxkbcommon0 libfontconfig1 libdbus-1-3 desktop-file-utils \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
