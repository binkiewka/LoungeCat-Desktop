FROM fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
RUN dnf install -y --setopt=install_weak_deps=False \
    gcc-c++ cmake ninja-build pkgconf-pkg-config git rpm-build \
    qt6-qtbase-devel qt6-qtsvg-devel alsa-lib-devel desktop-file-utils python3 \
    && dnf clean all
WORKDIR /src
